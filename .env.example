# DocuVieware license key. Empty = evaluation mode.
DOCUVIEWARE_LICENSE_KEY=
# Public base URL of the backend, embedded in the viewer markup (the browser must reach it).
AppUri=http://localhost:65088
# Document loaded into every new viewer session.
DefaultDocumentUri=http://localhost:65088/getting-started.pdf
# Backend URL used by the MVC frontend (same value as AppUri).
BackendBaseUrl=http://localhost:65088
# Address of the MVC frontend.
FrontendUrl=http://localhost:8090
